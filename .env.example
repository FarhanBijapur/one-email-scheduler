# Copy to .env for API and worker local overrides. Defaults in packages/shared
# match Docker Compose, but production must provide non-development values.
# The Vite browser variable is documented separately in apps/web/.env.example.

NODE_ENV=development

# --- API ---
API_HOST=0.0.0.0
API_PORT=3001
WEB_URL=http://localhost:5173

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=one
POSTGRES_PASSWORD=one
POSTGRES_DB=one
POSTGRES_PORT=5432
DATABASE_URL=postgres://one:one@localhost:5432/one

# --- Redis (Docker Compose, AOF persistence) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Elasticsearch (Docker Compose) ---
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200
# Optional for secured Elasticsearch deployments; set both or leave both blank.
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# --- Session and OAuth state ---
# Use a long random value in production.
SESSION_SECRET=dev-only-change-me-use-a-long-random-string
SESSION_TTL_HOURS=168

# --- Google OAuth (required to use Google login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
OAUTH_STATE_TTL_SECONDS=600

# --- Slack OAuth (optional; configure a Slack app to enable it) ---
# Add http://localhost:3001/api/slack/callback to the Slack app's Redirect URLs.
# The app requests only the bot scope chat:write and posts hourly-cap notices to App Home.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/callback
# Override only for a Slack-compatible test endpoint.
SLACK_OAUTH_AUTHORIZE_URL=https://slack.com/oauth/v2/authorize
SLACK_API_URL=https://slack.com/api/

# --- Ethereal SMTP (required to run the delivery worker) ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=

# --- Worker ---
WORKER_CONCURRENCY=5
